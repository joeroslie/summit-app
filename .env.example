# Summit local secrets (copy values into .env.local — never commit real keys)

# Instant Roofer AI (~$1–3 / address). Sandbox may include free credits.
# Use the API key from https://api-dashboard.instantroofer.com/ (API Keys)
# https://www.instantroofer.com/instant-roofer-api/
INSTANT_ROOFER_API_KEY=

# Optional: shared secret if you configure webhook auth in Instant Roofer
# INSTANT_ROOFER_WEBHOOK_SECRET=

# Optional: Google Solar for free squares/pitch fallback (no outline)
# GOOGLE_SOLAR_API_KEY=
