# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# local Instant Roofer human-order store
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local timestamped backups (do not lint / commit new ones)
.checkpoints/
*.backup

# Impeccable: keep shared detector config, ignore session/cache
.impeccable/*
!.impeccable/config.json
.impeccable/config.local.json

# Local phone mock — must not ship as a public URL
public/phone-preview.html
